---
// 欢迎页：套在博客的页面框架里，但用一个全屏图层盖住整个页面，看起来是独立的单页面。
// 这样进出欢迎页由 swup 切换、不整页刷新，音乐播放器不中断。
// 动画脚本在 src/scripts/welcome/（由 controller.ts 负责挂载 / 卸载），大幅插画在 src/components/welcome/。
import Flower from '@/components/welcome/Flower.astro'
import GitIcon from '@/components/welcome/GitIcon.astro'
import Mandala from '@/components/welcome/Mandala.astro'
import MusicIcon from '@/components/welcome/MusicIcon.astro'
import NoteIcon from '@/components/welcome/NoteIcon.astro'
import ProfileIcon from '@/components/welcome/ProfileIcon.astro'
import MainGridLayout from '@/layouts/MainGridLayout.astro'
const links = {
  blog: '/',
  about: '/about/',
  github: 'https://github.com/tracerZzz',
  // 网易云公开歌单：没有 JS 时，点音乐图标直接打开歌单页
  music: 'https://music.163.com/#/playlist?id=2059184801',
}
---

<MainGridLayout title="欢迎" description="A Craftsman 的欢迎页">
  <div id="welcome-root">
    {/* 刷新 / 直接打开欢迎页时：浏览器一解析到这里，就把欢迎页移到 <body> 下铺满窗口。
        放在最前面，不用等后面 300KB 的 SVG 解析完，也不等模块脚本（之后解析的内容照样进到欢迎页里）。
        swup 切换时这段不会执行，由 controller.ts 负责 */}
    <script is:inline>
      (function () {
        var root = document.currentScript && document.currentScript.parentElement
        if (root && root.id === 'welcome-root' && root.parentElement !== document.body) document.body.append(root)
      })()
    </script>
    <div id="wl-main">
      <div id="wl-bg"></div>
      <section id="wl-top">
        <svg id="welcomesvg" viewBox="-350 -250 700 500" preserveAspectRatio="xMaxYMid">
          <Flower />
          <text class="describeleft" x="110" y="-120" opacity="0">≡ 一砖一瓦，一凿一砌</text>
          <text class="describeleft" x="110" y="-20" opacity="0">≡ 命理念思想隐其内。</text>
          <text class="describeleft" x="110" y="80" opacity="0">≡ 而不足与外人道。</text>
        </svg>
        <svg id="welcomesvg2" viewBox="-350 -250 700 500" preserveAspectRatio="xMinYMid">
          <text class="describeright" x="-350" y="-120" opacity="0">≡ 令尽身精血聚其中，</text>
          <text class="describeright" x="-350" y="-20" opacity="0">≡ 其中艰辛历历在身，</text>
          <text class="describeright" x="-310" y="130" opacity="0">——工匠精神</text>
          <Mandala />
        </svg>
        <input id="wl-slider" type="range" min="0" max="100" step="0.1" value="0" aria-label="动画进度" />
      </section>

      <section id="wl-bottom">
        <div id="menubg">
          {Array.from({ length: 110 }, () => <div class="bgcircle" />)}
        </div>
        <div id="wl-menu">
          <svg id="menusvg" viewBox="-350 -250 700 500">
            <text class="testlist" x="-200" y="190" lengthAdjust="spacingAndGlyphs">enthusiasm • concentration•patience</text>
            <text class="testlist" x="-71" y="220" lengthAdjust="spacingAndGlyphs">热情 • 专注 • 耐心</text>

            <!-- 菜单打开后，四个子菜单从按钮四周飞出（位置见 src/scripts/welcome/index.ts） -->
            <a href={links.blog} aria-label="博客">
              <g id="lefttop" class="gmenulist" style="opacity:0">
                <rect class="menulist" x="150" y="50" width="100" height="100" stroke="gray" stroke-width="2" rx="15" ry="15" />
                <NoteIcon />
              </g>
            </a>
            <a href={links.github} aria-label="GitHub" target="_blank" rel="noopener">
              <g id="leftbottom" class="gmenulist" style="opacity:0">
                <rect class="menulist" x="150" y="-150" width="100" height="100" stroke="gray" stroke-width="2" rx="15" ry="15" />
                <GitIcon />
              </g>
            </a>
            <a href={links.about} aria-label="关于">
              <g id="righttop" class="gmenulist" style="opacity:0">
                <rect class="menulist" x="-250" y="50" width="100" height="100" stroke="gray" stroke-width="2" rx="15" ry="15" />
                <ProfileIcon />
              </g>
            </a>
            <a id="musiclink" href={links.music} aria-label="网易云音乐歌单" data-playlist="2059184801">
              <g id="rightbottom" class="gmenulist" style="opacity:0">
                <rect class="menulist" x="-250" y="-150" width="100" height="100" stroke="gray" stroke-width="2" rx="15" ry="15" />
                <MusicIcon />
              </g>
            </a>

            <!-- 中心菜单按钮 -->
            <g id="menubutton" role="button" tabindex="0" aria-label="菜单" aria-expanded="false">
              <rect id="menurect" x="-50" y="-50" rx="15" width="100" height="100" fill="black" stroke="#CB2727" stroke-width="3" />
              <line id="menutop" class="menuline" x1="-20" y1="-15" x2="20" y2="-15" stroke="lightgray" stroke-width="5" />
              <line id="menumid" class="menuline" x1="-20" y1="0" x2="20" y2="0" stroke="lightgray" stroke-width="5" />
              <line id="menubottom" class="menuline" x1="-20" y1="15" x2="20" y2="15" stroke="lightgray" stroke-width="5" />
            </g>
          </svg>
        </div>
      </section>
    </div>
    <!-- 音乐迷你播放器：用博客页面框架里的播放器（主题的 MusicManager），进出欢迎页时音乐不中断。
         鼠标移到音乐图标上时出现，移开后隐藏，音乐不停 -->
    <div id="musicpop" aria-label="音乐播放器">
      <div class="mp-head">
        <img id="mp-cover" alt="" />
        <div class="mp-meta">
          <div id="mp-title">加载中…</div>
          <div id="mp-artist"></div>
        </div>
      </div>
      <div class="mp-progress">
        <input id="mp-seek" type="range" min="0" max="1000" value="0" aria-label="播放进度" />
        <span id="mp-time">0:00</span>
      </div>
      <div class="mp-ctrl">
        <button id="mp-prev" type="button" aria-label="上一首">⏮</button>
        <button id="mp-play" type="button" aria-label="播放">▶</button>
        <button id="mp-next" type="button" aria-label="下一首">⏭</button>
        <button id="musiclist" type="button" aria-expanded="false">播放列表 ▾</button>
      </div>
      <ol id="mp-list"></ol>
      <a class="music-open" href={links.music} target="_blank" rel="noopener">在网易云音乐中打开歌单 ↗</a>
    </div>
    <noscript><a id="wl-noscript" href={links.blog}>进入博客 →</a></noscript>
  </div>
</MainGridLayout>

<style is:global>
  /* 全屏图层，盖住下面的博客页面。样式都限定在 #welcome-root 里，不影响博客 */
  html:has(#welcome-root) {
    overflow: hidden;
  }

  #welcome-root {
    position: fixed;
    inset: 0;
    z-index: 9999;
    overflow: hidden;
    background: black;
    font-family: 'Times New Roman', 'Songti SC', 'SimSun', serif;
  }

  /* 欢迎页在的时候，关掉主题内容区的入场动画和位移：
     祖先元素有 transform 时 position: fixed 会相对它定位，盖不住整个窗口 */
  #content-wrapper:has(#welcome-root) {
    animation: none;
    opacity: 1;
    transform: none;
  }

  #welcome-root.leaving {
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  @keyframes wl-fade-in {
    from {
      opacity: 0;
    }
  }

  #wl-main {
    position: absolute;
    inset: 0;
    /* 黑色背景一开始就不透明，盖住底下的博客；只让里面的内容淡入 */
    animation: wl-fade-in 0.3s ease;
  }

  #wl-bg {
    position: absolute;
    z-index: -1;
    width: 100%;
    height: 62%;
    background-color: lightgray;
  }

  #wl-top {
    position: relative;
    height: 62%;
    white-space: nowrap;
  }

  #wl-top > svg {
    display: inline-block;
    vertical-align: top;
    width: 49.2%;
    height: 100%;
  }

  #wl-top text {
    font-size: 22px;
  }

  #wl-bottom {
    height: 38%;
    min-height: 150px;
  }

  /* 下方的彩色圆点 */
  #menubg {
    position: fixed;
    top: 62%;
    z-index: -2;
    width: 100%;
    height: 38%;
    padding: 10px;
    overflow: hidden;
    background-color: black;
  }

  .bgcircle {
    float: left;
    width: 60px;
    height: 60px;
    margin: 30px 15px 0;
    border-radius: 50%;
    background-color: black;
    opacity: 0.22;
    /* 原来的 Power2.easeOut */
    transition:
      transform 5s cubic-bezier(0.215, 0.61, 0.355, 1),
      background-color 5s cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  #wl-menu {
    position: relative;
    width: 100%;
    height: 100%;
  }

  #menusvg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .testlist {
    fill: white;
    font-size: 18px;
    text-transform: uppercase;
  }

  #menubutton,
  .gmenulist {
    cursor: pointer;
    outline: none;
  }

  #menubutton:focus-visible #menurect {
    stroke: white;
  }

  /* 菜单收起时，隐藏的子菜单不响应点击 */
  #menusvg:not(.open) .gmenulist {
    pointer-events: none;
  }

  #musicsvg path {
    stroke: #fff;
    stroke-width: 2;
  }

  /* 进度条（原来是 jQuery UI 的 slider） */
  #wl-slider {
    position: absolute;
    bottom: 5px;
    left: 25%;
    width: 50%;
    height: 14px;
    margin: 0;
    background: transparent;
    cursor: pointer;
    appearance: none;
  }

  #wl-slider::-webkit-slider-runnable-track {
    height: 9px;
    border: 1px solid #aaa;
    border-radius: 4px;
    background: #fff;
  }

  #wl-slider::-moz-range-track {
    height: 9px;
    border: 1px solid #aaa;
    border-radius: 4px;
    background: #fff;
  }

  #wl-slider::-webkit-slider-thumb {
    width: 14px;
    height: 14px;
    margin-top: -3.5px;
    border: 1px solid #d3d3d3;
    border-radius: 4px;
    background: #e6e6e6;
    appearance: none;
  }

  #wl-slider::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: 1px solid #d3d3d3;
    border-radius: 4px;
    background: #e6e6e6;
  }

  /* 网易云音乐迷你播放器（隐藏时用 visibility，不用 display:none，保证音乐继续播放） */
  #musicpop {
    position: fixed;
    z-index: 10;
    padding: 10px 12px 4px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    background: rgba(17, 17, 17, 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
    font-family: system-ui, sans-serif;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.2s, transform 0.2s, visibility 0s 0.2s;
  }

  #musicpop.show {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 0.2s, transform 0.2s;
  }

  .mp-head {
    display: flex;
    gap: 10px;
    align-items: center;
    width: 260px;
    text-align: left;
  }

  #mp-cover {
    width: 48px;
    height: 48px;
    border-radius: 6px;
    background: #333;
    object-fit: cover;
  }

  #mp-cover:not([src]) {
    visibility: hidden;
  }

  .mp-meta {
    min-width: 0;
  }

  #mp-title,
  #mp-artist {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  #mp-title {
    color: #eee;
    font-size: 14px;
  }

  #mp-artist {
    margin-top: 2px;
    color: #9a9a9a;
    font-size: 12px;
  }

  .mp-progress {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 8px;
  }

  #mp-seek {
    flex: 1;
    height: 4px;
    accent-color: #cb2727;
  }

  #mp-time {
    color: #9a9a9a;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .mp-ctrl {
    display: flex;
    gap: 6px;
    align-items: center;
    margin-top: 4px;
  }

  .mp-ctrl button {
    padding: 2px 6px;
    border: 0;
    background: none;
    color: #d3d3d3;
    font: inherit;
    font-size: 15px;
    cursor: pointer;
  }

  .mp-ctrl button:hover {
    color: white;
  }

  #musiclist {
    margin-left: auto;
    font-size: 12px !important;
  }

  #mp-list {
    max-height: 0;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    list-style: none;
    text-align: left;
    transition: max-height 0.3s ease;
  }

  #musicpop.expanded #mp-list {
    max-height: 210px;
    margin-top: 4px;
  }

  #mp-list li {
    padding: 5px 6px;
    border-radius: 4px;
    overflow: hidden;
    color: #bdbdbd;
    font-size: 12px;
    white-space: nowrap;
    text-overflow: ellipsis;
    cursor: pointer;
  }

  #mp-list li:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  #mp-list li.current {
    color: white;
  }

  #mp-list li span {
    color: #777;
  }

  .music-open {
    display: inline-block;
    margin-top: 2px;
    color: #8a8a8a;
    font-size: 12px;
    text-decoration: none;
  }

  .music-open:hover {
    color: white;
  }

  #wl-noscript {
    position: fixed;
    top: 1rem;
    right: 1rem;
    color: black;
  }
</style>
